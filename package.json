{
  "name": "wsgem-cow-hooks",
  "private": true,
  "version": "0.1.0",
  "description": "CoW Swap Hook Store dapp: wrap tGBP into wstGBP after a buy (post-hook) or unwrap wstGBP to fund a tGBP sell (pre-hook), via the owner-bound WsgemHookHelper.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/lib/**'"
  },
  "dependencies": {
    "@cowprotocol/hook-dapp-lib": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.5.4",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite@^8": "8.1.6"
  }
}
